@model BibliotecaPrjt.Models.Autor

@{
    ViewData["Title"] = "Eliminar autor";
}

<h1>@ViewData["Title"]</h1>

<div class="mb-3">
    <strong>@Html.DisplayNameFor(m => m.Nombre):</strong>
    <span>@Model.Nombre</span>
</div>

<div class="mb-3">
    <strong>@Html.DisplayNameFor(m => m.Nacionalidad):</strong>
    <span>@Model.Nacionalidad</span>
</div>

<div class="mb-3">
    <strong>@Html.DisplayNameFor(m => m.FechaDeNacimiento):</strong>
    <span>@Model.FechaDeNacimiento.ToShortDateString()</span>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="ID" />
    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
