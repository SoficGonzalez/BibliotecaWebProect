@model BibliotecaPrjt.Models.Libro

@{
    ViewData["Title"] = "Eliminar Libro";
}

<h1>@ViewData["Title"]</h1>

<div class="mb-3">
    <strong>@Html.DisplayNameFor(m => m.Titulo):</strong>
    <span>@Model.Titulo</span>
</div>

<div class="mb-3">
    <strong>@Html.DisplayNameFor(m => m.Categoria):</strong>
    <span>@Model.Categoria</span>
</div>

<div class="mb-3">
    <strong>@Html.DisplayNameFor(m => m.Categoria):</strong>
    <span>@Model.Categoria</span>
</div>

<div class="mb-3">
    <strong>@Html.DisplayNameFor(m => m.Precio):</strong>
    <span>@Model.Precio</span>
</div>

<div class="mb-3">
    <strong>@Html.DisplayNameFor(m => m.Disponible):</strong>
    <span>@Model.Disponible</span>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="ID" />
    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
