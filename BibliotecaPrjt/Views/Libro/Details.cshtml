@model BibliotecaPrjt.Models.Libro

@{
    ViewData["Title"] = Model.Titulo;
    Layout = "_Layout";
}

<div class="details-page">
    <div class="details-image-col">
        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <img src="@Model.ImageUrl" alt="Portada de @Model.Titulo" class="details-image" />
        }
        else
        {
            <div class="details-image-vacia">Sin imagen</div>
        }
    </div>

    <div class="details-info-col">
        <span class="details-badge @(Model.Disponible ? "bg-success" : "bg-danger")">
            @(Model.Disponible ? "Disponible" : "Prestado")
        </span>

        <h1 class="details-titulo">@Model.Titulo</h1>
        <p class="details-autor">@Model.Autor</p>

        <div class="details-meta">
            <div class="details-meta-item">
                <span class="details-meta-label">Categoria</span>
                <span class="details-meta-valor">@Model.Categoria</span>
            </div>
            <div class="details-meta-item">
                <span class="details-meta-label">Precio</span>
                <span class="details-meta-valor">$@Model.Precio</span>
            </div>
        </div>

        <a asp-action="Index" class="details-volver">← Volver al catalogo</a>
    </div>
</div>