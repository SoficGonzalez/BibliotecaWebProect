@model BibliotecaPrjt.Models.Libro

@{
    ViewData["Title"] = "Sobre el libro";
}

<h1>@Model.Titulo</h1>
<dl class="row">
    <dt>Autor</dt>
    <dd>@Model.Autor</dd>

    <dt>Categoria</dt>
    <dd>@Model.Categoria</dd>

    <dt>Precio</dt>
    <dd>@Model.Precio</dd>

    <dt>Estado</dt>
    <dd>@Model.Disponible</dd>
</dl>

<a asp-action="Index" class="btn btn-primary">Volver al listado</a>