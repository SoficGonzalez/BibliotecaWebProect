@model BibliotecaPrjt.Models.Categoria

@{
    ViewData["Title"] = "Eliminar Categoria";
}

<h2>
    Eliminar Categoria
</h2>

<dl class="row">
    <dt class="col-sm-2">
        Nombre
    </dt>
    <dd class="col-sm-10">
        @Model.Nombre
    </dd>
    <dtclass ="col-sm-2">
        Descripccion
    </dtclass>
    <dd class="col-sm-10">
        @Model.Descripcion
    </dd>
</dl>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="ID" />
    <button type="submit" class="btn btn-danger">
        Eliminar
    </button>
    <a asp-action="Index" class="btn btn-secondary">
        Cancelar
    </a>
</form>