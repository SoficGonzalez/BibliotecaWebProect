@model IEnumerable<BibliotecaPrjt.Models.Libro>
@{
    ViewData["Title"] = "Catalogo de Libros";
}

<div class="catalogo-header">
    <div class="catalogo-header-spacer"></div>
    <h2 class="catalogo-titulo">@ViewData["Title"]</h2>
    <div class="catalogo-btn-wrapper">
        @if (User.IsInRole("Administrador"))
        {
            <a class="btn btn-primary text-nowrap" asp-action="Create">Nuevo Libro +</a>
        }
    </div>
</div>

@if (User.IsInRole("Administrador") || User.IsInRole("Bibliotecario"))
{
    <form method="get" class="d-flex flex-wrap justify-content-center align-items-center gap-2 bg-light border rounded-3 p-2 mx-auto mb-4" style="max-width: 760px;">
        <select name="autor" class="form-select form-select-sm w-auto" aria-label="Filtrar por autor">
            <option value="">Todos los autores</option>
            @foreach (var a in Model.Select(l => l.Autor).Distinct().OrderBy(x => x))
            {
                <option value="@a">@a</option>
            }
        </select>

        <div class="vr d-none d-md-block"></div>

        <button type="submit" asp-action="Report" formtarget="_blank"
                class="btn btn-outline-danger btn-sm text-nowrap">
            Ver PDF
        </button>
        <button type="submit" asp-action="ReportDownload"
                class="btn btn-danger btn-sm text-nowrap">
            Generar reporte PDF
        </button>
        <button type="submit" asp-action="ExportarExcel"
                class="btn btn-success btn-sm text-nowrap">
            Exportar a Excel
        </button>
    </form>
}

<div class="bento-grid">
    @foreach (var libro in Model)
    {
        <div class="libro-card">
            <span class="libro-estado badge @(libro.Disponible ? "bg-success" : "bg-danger")">
                @(libro.Disponible ? "Disponible" : "Prestado")
            </span>

            <div class="libro-imagen">
                @if (!string.IsNullOrEmpty(libro.ImageUrl))
                {
                    <img src="@libro.ImageUrl" alt="Portada de @libro.Titulo" />
                }
                else
                {
                    <div class="libro-imagen-vacia">Sin imagen</div>
                }
            </div>

            <div class="libro-id">#@libro.ID</div>
            <div class="libro-titulo">@libro.Titulo</div>
            <div class="libro-autor">@libro.Autor</div>
            <a asp-action="Details" asp-route-id="@libro.ID" class="libro-ref">Ver mas</a>
            <div class="libro-precio">$@libro.Precio</div>

            @if (User.IsInRole("Administrador"))
            {
               <div class="libro-acciones">
                <a class="btn btn-outline-primary btn-sm" asp-action="Edit" asp-route-id="@libro.ID">Editar</a>
               <form asp-action="Delete" asp-route-id="@libro.ID" method="post" class="swal-delete-form d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-danger">Eliminar</button>
                        </form>
            </div> 
            }
            
        </div>
    }
</div>