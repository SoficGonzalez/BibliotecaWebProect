@model IEnumerable<BibliotecaPrjt.Models.Libro>
@{
    ViewData["Title"] = "Catalogo de Libros";
}

<div class="catalogo-header">
    <div class="catalogo-header-spacer"></div>
    <h2 class="catalogo-titulo">@ViewData["Title"]</h2>
        <div class="catalogo-btn-wrapper">
        <a class="btn btn-primary" asp-action="Create">Nuevo Libro +</a>
        </div>
</div>

<div class="bento-grid">
    @foreach (var libro in Model)
    {
        <div class="libro-card">
            <span class="libro-estado badge @(libro.Disponible ? "bg-success" : "bg-danger")">
                @(libro.Disponible ? "Disponible" : "Prestado")
            </span>

            <div class="libro-imagen">
                @if (!string.IsNullOrEmpty(libro.ImageUrl))
                {
                    <img src="@libro.ImageUrl" alt="Portada de @libro.Titulo" />
                }
                else
                {
                    <div class="libro-imagen-vacia">Sin imagen</div>
                }
            </div>

            <div class="libro-id">#@libro.ID</div>
            <div class="libro-titulo">@libro.Titulo</div>
            <div class="libro-autor">@libro.Autor</div>
            <div class="libro-precio">$@libro.Precio</div>

            <div class="libro-acciones">
                <a class="btn btn-outline-primary btn-sm" asp-action="Edit" asp-route-id="@libro.ID">Editar</a>
                <a class="btn btn-outline-danger btn-sm" asp-action="Delete" asp-route-id="@libro.ID">Eliminar</a>
            </div>
        </div>
    }
</div>